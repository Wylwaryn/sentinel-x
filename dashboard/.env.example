# Variables du dashboard, à AJOUTER à server/.env (jamais commité).
# Le mot de passe MQTT_DASHBOARD_PASSWORD et DASHBOARD_DB_PASSWORD y sont déjà.

# Signature des sessions (JWT). Secret fort, 32 caractères minimum :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_JWT_SECRET=changez-moi
# Origines autorisées à appeler l'API (adresse du dashboard dans le navigateur), séparées par des virgules
# (https://127.0.0.1 : le PC hôte peut aussi ouvrir le dashboard par cette adresse)
DASHBOARD_ORIGINS=https://192.168.137.1,https://127.0.0.1
# Nom présenté quand le navigateur se connecte par IP (doit être dans le certificat de Caddy)
CADDY_SNI=sentinel-server
# IP réelles d'où le compte SERVICE_VISION peut se connecter (défaut : 10.0.2.2, le PC hôte vu de la VM)
SERVICE_VISION_IPS=10.0.2.2
# IP réelles du PC hôte : seules à pouvoir gérer les utilisateurs et les images de référence (même pour un ADMIN)
HOST_ONLY_IPS=10.0.2.2,192.168.137.1
