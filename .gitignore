# Secrets : jamais dans Git
.env
*.key
*.pem
certs/
secrets/

# Python
.venv/
__pycache__/
.pytest_cache/

# Modèles téléchargés
*.pt
*.onnx

# IDS : trafic capturé (IP de la table), modèles entraînés, journaux d'événements
host/ids/data/
host/ids/models/
host/ids/logs/
*.joblib

# Maintenance prédictive : télémétrie enregistrée, modèles, journaux
host/predictive/data/
host/predictive/models/
host/predictive/logs/

# Firmware : secrets (Wi-Fi, mot de passe MQTT) et fichiers de compilation
firmware/include/secrets.h
firmware/.pio/

# Sauvegarde locale du pare-feu Windows (configuration du PC)
host/hardening/backup/
