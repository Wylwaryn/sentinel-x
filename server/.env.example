# Copier en .env (jamais commité) et remplacer chaque valeur par un secret fort :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL : compte administrateur (migrations, maintenance uniquement)
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=changez-moi
# Mot de passe obligatoire partout, y compris en local dans le conteneur
POSTGRES_INITDB_ARGS=--auth-local=scram-sha-256 --auth-host=scram-sha-256

# Rôles applicatifs (créés par server/db/init/02-roles.sh)
INGEST_DB_PASSWORD=changez-moi
DASHBOARD_DB_PASSWORD=changez-moi

# Mosquitto (comptes MQTT). Laisser vide : sudo mosquitto/gen-passwd.sh les génère.
MQTT_ESP_PASSWORD=
MQTT_INGEST_PASSWORD=
MQTT_DASHBOARD_PASSWORD=
MQTT_VISION_PASSWORD=
