# Copier en .env (jamais commité) et remplacer chaque valeur par un secret fort :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL : compte administrateur (migrations, maintenance uniquement)
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=changez-moi
# Mot de passe obligatoire partout, y compris en local dans le conteneur
POSTGRES_INITDB_ARGS=--auth-local=scram-sha-256 --auth-host=scram-sha-256

# Rôles applicatifs (créés par server/db/init/02-roles.sh)
INGEST_DB_PASSWORD=changez-moi
DASHBOARD_DB_PASSWORD=changez-moi

# Mosquitto (comptes MQTT). Laisser vide : sudo mosquitto/gen-passwd.sh les génère.
MQTT_ESP_PASSWORD=
MQTT_INGEST_PASSWORD=
MQTT_DASHBOARD_PASSWORD=
MQTT_VISION_PASSWORD=
MQTT_CAPTEURS_PASSWORD=
MQTT_MONITOR_PASSWORD=

# API d'ingestion : un jeton Bearer par client. sudo ingest/gen-tokens.sh les génère.
INGEST_TOKEN_VISION=
INGEST_TOKEN_IDS=
INGEST_TOKEN_CAPTEURS=
# Numéro de série de l'ESP associé à la caméra (si la vision n'envoie pas "serie")
INGEST_DEFAULT_SERIE=
# Délai sans mesure avant l'alerte DISPOSITIF_HORS_LIGNE (secondes)
OFFLINE_AFTER_S=30

# Dashboard (session dashboard, dossier dashboard/) : services ajoutés à la stack par COMPOSE_FILE,
# pour qu'un simple « docker compose up -d » depuis server/ lance tout (voir dashboard/.env.example).
COMPOSE_FILE=docker-compose.yml:../dashboard/docker-compose.yml
DASHBOARD_JWT_SECRET=
DASHBOARD_ORIGINS=https://192.168.137.1,https://127.0.0.1
CADDY_SNI=sentinel-server
