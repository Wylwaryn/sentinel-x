{
  "device_serie": "SX-G2-01",
  "camera": {
    "name": "USB Camera",
    "index": 0,
    "width": 640,
    "height": 480,
    "fps": 30,
    "auto_exposure": true,
    "exposure": -6,
    "auto_white_balance": false,
    "white_balance": 4500,
    "gain": null,
    "fourcc": "MJPG",
    "capture_width": 1280,
    "capture_height": 720,
    "usb_wait_s": 15
  },
  "enhance": {
    "enabled": true,
    "dark_threshold": 100,
    "exit_threshold": 120,
    "clahe_clip": 2.0,
    "target_mean": 115,
    "lum_smooth": 0.3,
    "gamma_smooth": 0.25,
    "gamma_min": 0.35,
    "gamma_max": 3.0
  },
  "model": {
    "weights": "yolov8n.pt",
    "imgsz": 640,
    "conf": 0.45,
    "tracker": "bytetrack.yaml",
    "gpu_memory_fraction": 0.5
  },
  "motion": {
    "history": 300,
    "var_threshold": 25,
    "min_area_ratio": 0.005,
    "idle_after_s": 3.0,
    "idle_interval_s": 0.5
  },
  "zones": [
    {
      "name": "perimetre",
      "kind": "perimeter",
      "polygon": [
        [
          0.02,
          0.25
        ],
        [
          0.98,
          0.25
        ],
        [
          0.98,
          1.0
        ],
        [
          0.02,
          1.0
        ]
      ]
    },
    {
      "name": "zone_interdite",
      "kind": "restricted",
      "polygon": [
        [
          0.35,
          0.55
        ],
        [
          0.65,
          0.55
        ],
        [
          0.65,
          1.0
        ],
        [
          0.35,
          1.0
        ]
      ]
    }
  ],
  "behaviour": {
    "loiter_s": 10.0,
    "fast_speed": 0.6,
    "speed_window_s": 0.5,
    "track_timeout_s": 2.0
  },
  "fusion": {
    "pir_window_s": 3.0,
    "blind_spot_delay_s": 2.0,
    "cooldown_s": 10.0,
    "type_cooldown_s": {
      "presence": 60,
      "loitering": 60,
      "fast_approach": 30,
      "intrusion": 20,
      "pir_blind_spot": 60
    }
  },
  "faces": {
    "enabled": true,
    "module_dir": "../faces",
    "gallery": "../faces/data/gallery.npz",
    "threshold": 0.4,
    "confirm_hits": 2,
    "retry_s": 0.4,
    "reverify_s": 1.5,
    "presence_valid_s": 3.0,
    "grace_s": 2.0,
    "min_face_px": 40,
    "sync": {
      "enabled": true,
      "dashboard_url": "https://127.0.0.1",
      "interval_s": 60,
      "username_env": "SENTINEL_FACES_USER",
      "password_env": "SENTINEL_FACES_PASS",
      "origin": "https://192.168.137.1"
    }
  },
  "mqtt": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8883,
    "client_id": "sentinel-vision",
    "telemetry_topic": "sentinel/telemetry",
    "video_topic": "sentinel/video/cam1",
    "video_fps": 5,
    "video_quality": 70,
    "ca_cert": "../certs/ca.crt",
    "username_env": "SENTINEL_MQTT_USER",
    "password_env": "SENTINEL_MQTT_PASS"
  },
  "api": {
    "enabled": true,
    "url": "https://127.0.0.1:8443/api/v1/alerts",
    "token_env": "SENTINEL_VISION_TOKEN",
    "ca_cert": "../certs/ca.crt",
    "timeout_s": 2.0
  }
}