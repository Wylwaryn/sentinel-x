{
  "capture": {
    "iface": "Wi-Fi",
    "bpf": "ip",
    "window_s": 2.0,
    "protected_ips": [],
    "service_ports": [22, 443, 8883, 2222]
  },
  "model": {
    "dir": "models",
    "epochs": 300,
    "threshold_percentile": 99.5,
    "gpu_memory_fraction": 0.3
  },
  "response": {
    "mode": "alerte",
    "alert_score": 0.5,
    "critical_score": 0.85,
    "block_score": 0.85,
    "block_ttl_s": 300,
    "cooldown_s": 30,
    "whitelist": ["127.0.0.1"],
    "log_file": "logs/ids_events.jsonl"
  },
  "api": {
    "enabled": false,
    "url": "https://127.0.0.1:8443/api/v1/alerts",
    "token_env": "SENTINEL_IDS_TOKEN",
    "ca_cert": "../vision/certs/ca.crt",
    "timeout_s": 2.0
  }
}
